VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
GO_BUILD := CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=$(VERSION)"

.PHONY: dev build check clean image bench e2e helm bundle

# Go server on :8089, dummy target on :8090, Vite on :5173 (proxies /api to Go). Ctrl+C stops all.
dev: web/node_modules | web/dist
	@trap 'kill 0' INT TERM EXIT; \
	NDSWARM_DATA_DIR=.data NDSWARM_LOG_LEVEL=debug go run ./cmd/ndswarm & \
	go run ./cmd/dummytarget & \
	npm --prefix web run dev

build: web/node_modules
	npm --prefix web run build
	$(GO_BUILD) -o bin/ndswarm ./cmd/ndswarm
	$(GO_BUILD) -o bin/dummytarget ./cmd/dummytarget

check: web/node_modules | web/dist
	@test -z "$$(gofmt -l cmd internal web/*.go)" || { gofmt -l cmd internal web/*.go; echo "gofmt needed"; exit 1; }
	go vet ./...
	go test ./...
	npm --prefix web run typecheck
	npm --prefix web run lint
	npm --prefix web test

clean:
	rm -rf bin web/dist

IMAGE ?= ndswarm:dev
COMPOSE := docker compose -f deploy/docker-compose.yml

image:
	docker build -f deploy/Dockerfile -t $(IMAGE) --build-arg VERSION=$(VERSION) .

# Offline bundle of the current image (image file + compose + guide), like the release job makes.
bundle: image
	deploy/bundle.sh $(VERSION) $(IMAGE) dist

# Steady-state throughput of one instance against the dummy target, with the compose CPU limits.
bench: image
	@trap '$(COMPOSE) -p ndswarm-bench down -v >/dev/null 2>&1' EXIT; \
	NDSWARM_PORT=18089 NDSWARM_CPUS=4 NDSWARM_IMAGE=$(IMAGE) $(COMPOSE) -p ndswarm-bench up -d --wait && \
	go run ./tools/bench -url http://127.0.0.1:18089 -target http://dummytarget:8090 -container ndswarm-bench-ndswarm-1

web/node_modules: web/package-lock.json
	npm --prefix web ci
	@touch $@

# go:embed needs web/dist to exist; the server shows "UI not built" until `make build`.
web/dist:
	mkdir -p $@ && touch $@/.keep

PLAYWRIGHT := mcr.microsoft.com/playwright:v$(shell node -p "require('./e2e/package.json').devDependencies['@playwright/test']")-noble

# Browser smoke test against a fresh compose stack (image built from this tree).
e2e: image
	@trap '$(COMPOSE) -p ndswarm-e2e down -v >/dev/null 2>&1' EXIT; \
	NDSWARM_PORT=18088 NDSWARM_IMAGE=$(IMAGE) $(COMPOSE) -p ndswarm-e2e up -d --wait && \
	docker run --rm --network host --ipc host -e BASE_URL=http://127.0.0.1:18088 -v $(CURDIR)/e2e:/e2e -w /e2e $(PLAYWRIGHT) \
		sh -c 'npm ci --no-audit --no-fund >/dev/null && npx playwright test'

# Lint the chart, regenerate the plain manifest and validate both (no cluster needed).
HELM := docker run --rm -v $(CURDIR)/deploy/helm:/charts -w /charts alpine/helm:3.19.0
KUBECONFORM := docker run --rm -i ghcr.io/yannh/kubeconform:v0.7.0 -strict -summary -
helm:
	$(HELM) lint ndswarm --set ingress.enabled=true
	$(HELM) template ndswarm ndswarm --set ingress.enabled=true | $(KUBECONFORM)
	{ echo '# Generated by `make helm` from deploy/helm/ndswarm. Edit the chart, not this file.'; \
	  echo '# kubectl create namespace ndswarm && kubectl -n ndswarm apply -f deploy/k8s/ndswarm.yaml'; \
	  $(HELM) template ndswarm ndswarm --namespace ndswarm; } > deploy/k8s/ndswarm.yaml
	$(KUBECONFORM) < deploy/k8s/ndswarm.yaml
